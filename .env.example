NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
ACCESS_WINDOW_START=07:00
ACCESS_WINDOW_END=21:00
GATEWAY_PORT=3000
GRADE_SERVICE_PORT=3001
TRANSCRIPT_SERVICE_PORT=3002
UPSTREAM_TIMEOUT_MS=5000
GATEWAY_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/zero-trust.sqlite
LOG_PATH=./logs/app.log
GATEWAY_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
SERVICE_CLIENT_ID=nilai-service
SERVICE_CLIENT_SECRET=replace-with-a-different-long-random-value
